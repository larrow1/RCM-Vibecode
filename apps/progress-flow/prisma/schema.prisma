datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-progress"
}

model Engagement {
  id         String   @id @default(cuid())
  name       String
  clientName String
  type       String
  status     String   @default("Scoping")
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  flows Flow[]
}

model FlowTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String
  phases      String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model Flow {
  id           String   @id @default(cuid())
  engagementId String
  name         String
  description  String?
  status       String   @default("Not Started")
  templateId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  phases     Phase[]

  @@index([engagementId])
  @@index([status])
}

model Phase {
  id          String   @id @default(cuid())
  flowId      String
  name        String
  description String?
  sortOrder   Int      @default(0)
  status      String   @default("Not Started")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flow  Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([flowId])
}

model Task {
  id          String    @id @default(cuid())
  phaseId     String
  title       String
  description String?
  status      String    @default("Pending")
  priority    String    @default("Medium")
  assignee    String?
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  aiGenerated Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  phase Phase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@index([status])
  @@index([priority])
}
